# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# Required for posters, trailers and watch links.
# Get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Optional
# Preferred language for TMDB metadata.
# TMDB_LANG=en-US

# Days a TMDB response stays valid in tmdb_cache.pkl.
# TMDB_CACHE_TTL_DAYS=30

# --- A network that BLOCKS TMDB outright ---------------------------------------
# Distinct from the interception case below: some gateways refuse TLS to
# specific hosts rather than re-signing it. Nothing local can fix that -- no CA
# bundle, no SSL setting -- because the connection never completes.
#
# For that case the app routes around it through two public services:
#
#   * the API response is fetched via a relay, so the request never leaves
#     through the blocked route;
#   * poster images are fetched via an image proxy, since image.tmdb.org is
#     almost always blocked by the same rule.
#
# Relay order is r.jina.ai, then api.allorigins.win. They are free services and
# they rate-limit, so expect the occasional slow lookup.
#
# *** Your API key travels in the relay's request URL, so the relay operator can
# *** read it. That is fine for a local project and NOT fine for a shared or
# *** public deployment. Rotate the key at the link above if you use this.
#
# auto  (default) try the direct route first, fall back to a relay
# only            never try the direct route
# off             refuse the relay and report the block
# TMDB_RELAY=auto

# --- Network that TLS-intercepts HTTPS -----------------------------------------
# Some networks (corporate gateways, Sophos SSL VPN, Zscaler) re-sign outbound
# HTTPS with their own CA. Python does not trust those by default, so TMDB
# fails with CERTIFICATE_VERIFY_FAILED and no posters load.
#
# Best fix: ask IT to exclude these hosts from the proxy --
#     api.themoviedb.org
#     image.tmdb.org
#
# If you cannot get the proxy excluded but you can obtain its CA certificate
# (ask IT, or export it from the appliance), point this at the .pem/.crt file.
# Verification stays ON, which is the safe way to do it.
# TMDB_CA_BUNDLE=C:\path\to\proxy-ca.pem

# Last resort, and worse than the relay: turns certificate verification OFF
# entirely, so an intercepting proxy can read your API key and every response.
# Local use only, never on a shared or deployed copy.
# TMDB_INSECURE_SSL=1
