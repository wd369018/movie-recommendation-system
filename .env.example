# Copy to .env and fill in. .env is gitignored -- never commit real keys.

# Required for posters, trailers and watch links.
# Get one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Optional
# Preferred language for TMDB metadata.
# TMDB_LANG=en-US

# Days a TMDB response stays valid in tmdb_cache.pkl.
# TMDB_CACHE_TTL_DAYS=30

# Only if your network TLS-intercepts HTTPS (corporate proxy / antivirus) and
# TMDB certificate checks fail. Disables verification -- local use only.
# TMDB_INSECURE_SSL=1
